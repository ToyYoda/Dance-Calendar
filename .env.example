# Öffentliche Adresse der App (für Links in WhatsApp-Nachrichten und iCal-Feeds)
BASE_URL=http://localhost:8000
TIMEZONE=Europe/Berlin
DEFAULT_COUNTRY_CODE=49

# Datenbank und Bildablage
DATABASE_URL=sqlite:///data/dance.db
MEDIA_DIR=data/media

# Admin-Whitelist (Telefonnummern, kommagetrennt). Nur diese Nummern bekommen Magic Links.
ADMIN_PHONES=+491701234567

# KI: "mock" für Entwicklung, "openai" für jede OpenAI-kompatible API.
# Lokal mit Ollama:  ollama pull llama3.2-vision
AI_PROVIDER=mock
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3.2-vision
# Optional ein kleineres, schnelleres Modell für die Flyer-Triage
AI_CLASSIFIER_MODEL=
AI_TIMEOUT=120

# Adressvervollständigung: "nominatim" (OpenStreetMap) oder "off"
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=dance-calendar/1.0 (kontakt@example.com)

# WhatsApp: "console" protokolliert nur, "cloud" nutzt die WhatsApp Cloud API
MESSENGER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# DEV_MODE=1 zeigt Login-Codes und Magic Links direkt an (nur ohne echten Messenger!)
DEV_MODE=1
# In Produktion hinter HTTPS auf 1 setzen
COOKIE_SECURE=0
